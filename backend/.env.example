APP_NAME=School Management System
DEBUG=True

# Dev: SQLite
DATABASE_URL=sqlite:///./school.db

# Prod example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

JWT_SECRET=replace_with_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=*

LOG_FILE=logs/app.log
API_V1_PREFIX=/api/v1

# Password reset emails (optional). If left blank, reset links are logged
# to the server console instead of emailed — fine for local dev, but set
# these for real deployments. Works with Gmail using an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=School Hub

# Used to build the password reset link. Set this to your deployed URL
# (e.g. https://schoolhub-ivory.vercel.app) in production.
FRONTEND_BASE_URL=http://127.0.0.1:8000

# AI features (optional) — student summaries & class reports via Groq.
# Get a free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Storage — required for student photo/ID-card/B-form/test-paper
# uploads. Uses the SAME Supabase project as your database (Postgres URL).
# 1. Supabase dashboard -> Project Settings -> API
#      SUPABASE_URL           = https://<project-ref>.supabase.co
#      SUPABASE_SERVICE_KEY   = the "service_role" secret key (NOT anon key)
# 2. Supabase dashboard -> Storage -> New bucket -> name it "student-files"
#      Leave it PRIVATE (do not toggle "Public bucket") — B-forms/CNIC
#      images are sensitive, so files are served via short-lived signed
#      URLs instead of permanent public links.
# Without these set, upload endpoints return a clear "not configured" error;
# everything else keeps working normally.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=student-files
